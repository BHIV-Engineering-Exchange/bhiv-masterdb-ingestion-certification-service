{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bhiv:schemas:dataset-contract.schema.json",
  "title": "Consumer Dataset Contract Bundle",
  "description": "Consumer-safe dataset contracts with shared schema references. Repository source paths belong only in the internal registry.",
  "type": "object",
  "required": ["contracts", "shared_schemas"],
  "properties": {
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    },
    "shared_schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://json-schema.org/draft/2020-12/schema"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "publicValue": {
      "oneOf": [
        {"$ref": "#/$defs/publicObject"},
        {"$ref": "#/$defs/publicArray"},
        {"type": ["string", "number", "integer", "boolean", "null"]}
      ]
    },
    "publicObject": {
      "type": "object",
      "not": {"required": ["source_file"]},
      "additionalProperties": {"$ref": "#/$defs/publicValue"}
    },
    "publicArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/publicValue"}
    },
    "consumer": {
      "type": "object",
      "required": ["consumer_id", "name", "domain"],
      "properties": {
        "consumer_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "dataset_id",
        "name",
        "capability_id",
        "version",
        "description",
        "status",
        "visibility",
        "sensitivity",
        "domain",
        "allowed_domains",
        "contract_kind",
        "schema",
        "allowed_purposes",
        "allowed_consumers",
        "provenance"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["candidate", "sample", "synthetic", "internal"]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "restricted"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["low", "moderate", "high", "restricted"]
        },
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        },
        "contract_kind": {
          "type": "string",
          "enum": ["dataset", "synthetic_dataset", "failure_fixture"]
        },
        "schema": {
          "type": "object",
          "required": ["$ref"],
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^#/shared_schemas/[a-zA-Z0-9._-]+$"
            }
          },
          "additionalProperties": false
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_consumers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/consumer"}
        },
        "provenance": {
          "allOf": [
            {"$ref": "#/$defs/publicObject"},
            {"minProperties": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"contract_kind": {"const": "failure_fixture"}}, "required": ["contract_kind"]},
          "then": {
            "properties": {
              "status": {"const": "internal"},
              "visibility": {"const": "internal"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
