# Copy this file to .env and fill in real values. Nothing here is a real
# secret — these are the variable NAMES the app reads, not credentials.

# --- MDU integration (Nupur's team) -----------------------------------------
# Required for real MDU calls (schema/provenance lookups). Without these set,
# MDUClient calls will fail — get real values from Nupur/the MDU team.
MDU_BASE_URL=
MDU_API_KEY=

# --- Auth (JWT issuance/verification) ---------------------------------------
# HS256 signing secret for tokens issued by POST /auth/token. If unset, the
# process generates a random secret at startup and logs a warning — tokens
# won't validate after a restart or across multiple worker processes. Set
# this to a real secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# before treating this as production-hardened. See auth/service.py.
AUTH_JWT_SECRET=

# --- Persistence --------------------------------------------------------------
# Directory for disk-persisted bcaes_registry and canonical_repository data.
# If unset, both stay pure in-memory (reset on every restart) — this is the
# default and what every test relies on. Set this to opt in to persistence.
# IMPORTANT: on Render's default (non-Disk) plans the filesystem is wiped on
# every deploy/restart regardless of this setting — you need a persistent
# Disk attached in Render's dashboard, mounted at whatever path you set here,
# for this to actually survive across restarts in production. See
# PRODUCTION_HARDENING.md.
MASTERDB_STORAGE_DIR=

# --- Real database (central DB) -----------------------------------------------
# Set this to back bcaes_registry and canonical_repository with a real SQL
# database instead of JSON files. Takes priority over MASTERDB_STORAGE_DIR
# when both are set. sqlite:///path/to/file.db works with zero external
# services for local dev; postgresql://user:pass@host:5432/dbname for real
# production. See DATABASE.md for schema/design and why external services
# still go through the authenticated API rather than getting this directly.
MASTERDB_DATABASE_URL=

# --- InsightBridge (Vijay Dhawan / InsightFlow) --------------------------------
# Confirmed live 6 Aug 2026 (see ECOSYSTEM_ENDPOINTS.md). Set to enable
# POST /observability/push-to-insightbridge; without it, that endpoint
# returns {"pushed": false, "reason": "..."} rather than erroring.
PRAVAH_BHIV_INSIGHT_FLOW_BRIDGE=

# --- Rate limiting --------------------------------------------------------------
# Sliding window, in-memory/per-process (NOT distributed-safe — see
# middleware/rate_limiter.py). Defaults: 120 requests per 60 seconds per
# actor (or per IP if unauthenticated). Health/ready/metrics/docs are exempt.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
