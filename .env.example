# Copy this file to .env and fill in real values. DO NOT use these placeholder values in production.
# These are the variable NAMES the app reads, not credentials.

# --- Postgres Database (REQUIRED) --------------------------------------------------
# NASA FIRMS server-side map key; obtain a free key from NASA LANCE FIRMS.
FIRMS_MAP_KEY=
TOMTOM_API_KEY=

# Password MUST be changed before production deployment.
# Generate a strong password: python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_DB=masterdb
POSTGRES_USER=masterdb
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- Docker Build & Deployment ----------------------------------------
# Used by docker-compose.yml for image naming and port binding
DOCKER_USERNAME=myregistry
IMAGE_TAG=latest
MASTERDB_PORT=8000

# --- MDU Integration (Nupur's team) -----------------------------------------
# Required for real MDU calls (schema/provenance lookups). Without these set,
# MDUClient calls will fail â€” get real values from Nupur/the MDU team.
# IMPORTANT: Do NOT commit real API keys to version control.
MDU_BASE_URL=https://bhiv-mdu-api.onrender.com
MDU_API_KEY=CHANGE_ME_WITH_REAL_MDU_API_KEY

# --- Environment Mode -------------------------------------------------------
# Set to 'production' to enforce production safety gates (persistent storage required,
# in-memory storage prohibited, AUTH_JWT_SECRET required).
ENVIRONMENT=production

# --- Auth (JWT issuance/verification) ---------------------------------------
# HS256 signing secret for tokens issued by POST /auth/token. MUST be a strong,
# random value (at least 32 characters in production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In production mode, this MUST be set or the service fails closed at startup.
AUTH_JWT_SECRET=CHANGE_ME_WITH_STRONG_RANDOM_SECRET

# --- Authentication & Credential Separation ---------------------------------
# Standard user password (issues tokens with standard unprivileged roles).
# If unset, authentication fails closed and no tokens can be issued.
AUTH_PASSWORD=CHANGE_ME_STANDARD_USER_PASSWORD

# Dedicated administrative password (required to issue tokens with 'admin' or 'bhiv-admin' roles).
# Must be distinct from standard password. If unset, administrative roles cannot be granted.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Persistence (Required in production, optional in dev/test) -----------------
# Directory for disk-persisted bcaes_registry and canonical_repository data.
# In dev/test: if unset, both stay pure in-memory (reset on every restart).
# In production: either MASTERDB_DATABASE_URL or MASTERDB_STORAGE_DIR is REQUIRED.
# IMPORTANT: On Render's default (non-Disk) plans the filesystem is wiped on
# every deploy/restart regardless of this setting. You need a persistent Disk
# attached in Render's dashboard for this to survive across restarts.
# See PRODUCTION_HARDENING.md for details.
MASTERDB_STORAGE_DIR=/tmp/masterdb

# --- Real Database Backend (Required in production if STORAGE_DIR unset) ---------
# Set this to back bcaes_registry and canonical_repository with a real SQL database
# instead of JSON files. Takes priority over MASTERDB_STORAGE_DIR when both are set.
# Ephemeral in-memory database configurations (e.g. :memory:) are rejected in production.
# Examples:
#   - sqlite:///path/to/file.db (zero external services, local dev / file-based persistence)
#   - postgresql://user:password@host:5432/dbname (production)
# See DATABASE.md for schema/design details.
# MASTERDB_DATABASE_URL=postgresql://masterdb:password@postgres:5432/masterdb

# --- InsightBridge Integration (Vijay Dhawan / InsightFlow) ----------------------
# Confirmed live 6 Aug 2026 (see ECOSYSTEM_ENDPOINTS.md).
# Set to enable POST /observability/push-to-insightbridge; without it, that endpoint
# returns {"pushed": false, "reason": "..."} rather than erroring.
# PRAVAH_BHIV_INSIGHT_FLOW_BRIDGE=https://insight-bridge-endpoint/ingest

# --- Pravah Bucket Storage Integration (Optional) --------------------------------
# Set to enable external bucket storage integration for /bucket/* and /evidence/* endpoints.
# If unset, the bucket client correctly reports unavailable (HTTP 503 BucketUnavailableError).
# PRAVAH_BHIV_BUCKET=https://bucket-endpoint/

# --- Rate Limiting (Optional) -------------------------------------------------------
# Sliding window, in-memory/per-process (NOT distributed-safe).
# Default: 120 requests per 60 seconds per actor (or per IP if unauthenticated).
# Health/ready/metrics/docs endpoints are exempt from rate limiting.
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- VANA Forest & Mangrove Governance Integration ----------------------------
# Required for real VANA calls (6-tuple governance evaluation, FSI ISFR 2023,
# Thane Creek blue carbon, and spatial GIS layers).
# Local co-hosting default is port 8001 (to avoid collision with MASTERDB port 8000).
VANA_BASE_URL=http://localhost:8001
VANA_API_KEY=

# --- Bharat Mala & Marine Intelligence Integration ---------------------------
# Bearer token for accessing Bharat Mala / Marine Intelligence API services
BHARATMALA_ACCESS_TOKEN=CHANGE_ME_WITH_REAL_ACCESS_TOKEN
MARINE_INTELLIGENCE_TOKEN=CHANGE_ME_WITH_REAL_ACCESS_TOKEN


# Local God’s Eye View proxy for GFS and ECMWF forecast grids (no API key).
GODS_EYE_VIEW_BASE_URL=http://127.0.0.1:4173
